# =============================================================================
# Wix API Client 환경 변수
# =============================================================================
# 이 파일을 .env 로 복사한 후 실제 값 입력.
# cp .env.example .env
# =============================================================================

# [필수] Wix API Key
# 발급: https://manage.wix.com/account/api-keys
WIX_API_KEY=your-api-key-here

# [택1] Site ID — 개별 사이트 단위 접근
# 확인: Wix 대시보드 URL → https://manage.wix.com/dashboard/{SITE_ID}/...
WIX_SITE_ID=your-site-id-here

# [택1] Account ID — 계정 전체 단위 접근
# 확인: API Keys Manager 페이지에서 확인
# WIX_ACCOUNT_ID=your-account-id-here

# =============================================================================
# 선택 설정 (기본값이 있으므로 변경 필요 시에만 설정)
# =============================================================================

# API Base URL (기본값: https://www.wixapis.com)
# WIX_BASE_URL=https://www.wixapis.com

# HTTP 연결 타임아웃 (초, 기본값: 10)
# WIX_CONNECT_TIMEOUT=10

# HTTP 읽기 타임아웃 (초, 기본값: 30)
# WIX_READ_TIMEOUT=30

# 최대 재시도 횟수 (기본값: 3)
# WIX_MAX_RETRIES=3
